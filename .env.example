# Copy to .env.local and fill in. Validated by src/config/env.ts at boot.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/automocion?sslmode=require"

# --- Auth -------------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Sólo para un despliegue de DEMOSTRACIÓN. Si se define, la siembra crea las
# cuentas del equipo con esta contraseña incluso en producción. Déjala vacía en
# un entorno real: las cuentas se activan por invitación.
SEED_ADMIN_PASSWORD=""

# --- TRM (Tasa Representativa del Mercado) daily feed -----------------------
TRM_API_URL=""
TRM_API_TOKEN=""

# --- Services ---------------------------------------------------------------
RESEND_API_KEY=""
ANTHROPIC_API_KEY=""
BLOB_READ_WRITE_TOKEN=""
CRON_SECRET=""
