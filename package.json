{
  "name": "automocion-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/check-message-parity.mjs",
    "verify": "npm run typecheck && npm run lint && npm run i18n:check && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "smoke:pages": "node scripts/smoke-pages.mjs",
    "smoke:quote": "tsx scripts/smoke-save-quote.ts",
    "price:catalog": "tsx scripts/price-catalog.ts",
    "smoke:pdf": "tsx scripts/smoke-pdf.ts",
    "seed:quotes": "tsx scripts/seed-quotes.ts",
    "smoke:all": "npm run smoke:pages && npm run smoke:quote && npm run smoke:pdf",
    "photos:fetch": "tsx scripts/fetch-vehicle-photos.ts",
    "brand:prepare": "tsx scripts/prepare-brand-assets.ts",
    "seed:orders": "tsx scripts/seed-orders.ts",
    "seed:leads": "tsx scripts/seed-leads.ts",
    "seed:social": "tsx scripts/seed-social.ts",
    "seed:demo": "npm run db:seed && npm run seed:quotes && npm run seed:orders && npm run seed:leads && npm run seed:social"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^6.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "lucide-react": "^1.41.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^3.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.17",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.0"
  }
}
