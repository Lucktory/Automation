/// Regimen bajo el cual la unidad puede entrar a Colombia.
/// La importacion ORDINARIA de vehiculos USADOS esta prohibida.
/// Este enum + Vehicle.eligibilityStatus son el guardrail legal del catalogo.
enum ImportRegime {
  ORDINARY_IMPORT // solo NEW / DEMO 0 km
  FREE_ZONE // ingreso a Zona Franca (NO cura la prohibicion al nacionalizar)
  TEMPORARY_IMPORT // importacion temporal
  DIPLOMATIC // franquicia diplomatica
  CLASSIC_ANTIQUE // clasico >= 35 anos + cert. Automovil Club de Colombia
  RETURNING_RESIDENT // menaje / retorno (Ley 1565 de 2012)
  RE_EXPORT // se compra en ZF y se reexporta, nunca entra a TAN
}

