/// Politica cambiaria declarada en la propuesta: define quien asume el riesgo
/// TRM entre el envio y el pago. Art. 846 C.Co: la oferta comunicada es
/// IRREVOCABLE durante su plazo.
enum FxPolicy {
  FIXED_COP_UNTIL_EXPIRY // precio COP en firme: el importador asume el riesgo
  BANDED // firme mientras la TRM se mueva dentro de fxToleranceBps
  INDEXED_AT_PAYMENT // se reliquida con la TRM del dia de pago
  QUOTED_IN_USD // precio en USD; COP solo informativo
}

