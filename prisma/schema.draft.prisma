// =====================================================================
// AUTOMOCION OS / TOP GEAR - Esquema de datos
// Postgres 15+ / Prisma 6
// Convencion: modelos en ingles, terminos legales colombianos en espanol.
// Dinero: SIEMPRE Decimal. NUNCA Float.
//   - COP  -> @db.Decimal(18, 2)
//   - USD  -> @db.Decimal(14, 2)
//   - tasas/porcentajes -> @db.Decimal(9, 6)  (0.350000 = 35%)
//   - TRM  -> @db.Decimal(14, 6)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

