// =====================================================================
// 1. AUTENTICACION Y PERSONAS  (Auth.js / NextAuth v5 compatible)
// =====================================================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  phone         String? // E.164: +573001234567
  image         String?
  passwordHash  String? // null si solo usa OAuth
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  locale        String     @default("es-CO")

  // Datos de facturacion / aduana del cliente colombiano
  documentType String? // CC, CE, NIT, PAS
  documentId   String?
  fiscalName   String?
  addressLine  String?
  city         String?
  department   String? // departamento
  countryCode  String  @default("CO")

  // Habeas data (Ley 1581 de 2012 / Dto 1377 de 2013)
  dataConsentAt      DateTime?
  dataConsentVersion String?
  marketingOptIn     Boolean   @default(false)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  accounts          Account[]
  sessions          Session[]
  ownedLeads        Lead[]                @relation("LeadOwner")
  leadRecord        Lead?                 @relation("LeadUser")
  quotesAsCustomer  Quote[]               @relation("QuoteCustomer")
  quotesCreated     Quote[]               @relation("QuoteCreatedBy")
  orders            Order[]               @relation("OrderCustomer")
  ordersManaged     Order[]               @relation("OrderAccountManager")
  orderEvents       OrderStatusEvent[]
  documentUploads   DocumentUpload[]      @relation("DocUploader")
  documentReviews   DocumentUpload[]      @relation("DocReviewer")
  posts             Post[]
  auditLogs         AuditLog[]
  chatConversations ChatConversation[]    @relation("ChatUser")
  chatAssigned      ChatConversation[]    @relation("ChatAgent")
  parameterSets     PricingParameterSet[] @relation("ParamSetAuthor")
  fxOverrides       FxRate[]              @relation("FxOverrideBy")
  payments          Payment[]             @relation("PaymentRecordedBy")

  @@index([role, status])
  @@index([documentType, documentId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ip           String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =====================================================================
// 2. GEOGRAFIA Y ACUERDOS COMERCIALES
// =====================================================================

model Country {
  code        String   @id @db.Char(2) // ISO 3166-1 alpha-2: US, CN, AE, DE, CA, KR, JP
  code3       String   @unique @db.Char(3)
  nameEs      String
  nameEn      String
  region      String? // NORTH_AMERICA, ASIA, EUROPE, MIDDLE_EAST
  isOriginHub Boolean  @default(false) // aparece en el selector de origen del cotizador
  flagEmoji   String?
  mapLat      Decimal? @db.Decimal(9, 6) // para el Mapa Global Interactivo
  mapLng      Decimal? @db.Decimal(9, 6)

  ports          Port[]
  tariffRules    TariffRule[]
  vehicleOrigins Vehicle[]               @relation("VehicleOriginCountry")
  brands         Brand[]
  agreements     TradeAgreementCountry[]

  @@map("countries")
}

model Port {
  id              String   @id @default(cuid())
  unlocode        String   @unique // CNSHA, USLAX, AEJEA, DEBRV, COBUN, COCTG
  name            String
  countryCode     String   @db.Char(2)
  isOrigin        Boolean  @default(true)
  isDestination   Boolean  @default(false)
  lat             Decimal? @db.Decimal(9, 6)
  lng             Decimal? @db.Decimal(9, 6)
  freeDaysDefault Int? // dias libres de almacenamiento antes de demurrage
  notes           String?
  active          Boolean  @default(true)

  country            Country         @relation(fields: [countryCode], references: [code])
  freightRatesFrom   FreightRate[]   @relation("FreightOrigin")
  freightRatesTo     FreightRate[]   @relation("FreightDestination")
  vehicles           Vehicle[]       @relation("VehicleOriginPort")
  consolidationsFrom Consolidation[] @relation("ConsolidationOrigin")
  consolidationsTo   Consolidation[] @relation("ConsolidationDestination")

  @@index([countryCode, isOrigin])
  @@map("ports")
}

/// Acuerdo comercial vigente. Determina el arancel preferencial y el
/// documento de origen exigible (certificado / declaracion de origen).
model TradeAgreement {
  id                  String    @id @default(cuid())
  code                String    @unique // TLC_USA, TLC_UE, TLC_COREA, TLC_CANADA, CAN, ACE_33_MEX, ALIANZA_PACIFICO
  name                String
  legalBasis          String? // Ley 1143 de 2007, Decreto 730 de 2012, etc.
  legalUrl            String?
  inForceFrom         DateTime  @db.Date
  inForceTo           DateTime? @db.Date
  originProofRequired Boolean   @default(true)
  originProofType     String? // CERTIFICADO_DE_ORIGEN | DECLARACION_DE_ORIGEN | AUTOCERTIFICACION
  notes               String?

  countries   TradeAgreementCountry[]
  tariffRules TariffRule[]

  @@map("trade_agreements")
}

model TradeAgreementCountry {
  agreementId String
  countryCode String @db.Char(2)

  agreement TradeAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  country   Country        @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@id([agreementId, countryCode])
  @@map("trade_agreement_countries")
}

/// Subpartida arancelaria (NANDINA 8 + 2 digitos nacionales = 10).
model HsCode {
  code            String    @id // "8703801000" sin puntos, 10 digitos
  formatted       String // "8703.80.10.00"
  description     String
  chapter         String    @db.Char(2) // "87"
  heading         String    @db.Char(4) // "8703"
  unitOfMeasure   String? // "U"
  requiresLicense Boolean   @default(false)
  notes           String?
  verifiedAt      DateTime?
  verifiedBy      String?

  trims       Trim[]
  vehicles    Vehicle[]
  tariffRules TariffRule[]

  @@index([heading])
  @@map("hs_codes")
}

// =====================================================================
// 3. CATALOGO  (Brand -> Model -> Trim -> Vehicle)
//    Las specs viven en el Trim (dato canonico del fabricante);
//    el Vehicle solo guarda lo propio de la unidad (VIN, lote, color, km).
// =====================================================================

model Brand {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String   @unique
  logoUrl      String?
  countryCode  String?  @db.Char(2) // pais de la marca (NO es el origen aduanero)
  description  String?  @db.Text
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  country Country? @relation(fields: [countryCode], references: [code])
  models  Model[]

  @@index([active, displayOrder])
  @@map("brands")
}

model Model {
  id           String   @id @default(cuid())
  brandId      String
  slug         String
  name         String // "Atto 3", "Model Y", "Corolla Cross"
  bodyType     BodyType
  generation   String? // "SU2 (2022-)"
  yearFrom     Int?
  yearTo       Int?
  heroImageUrl String?
  description  String?  @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brand Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  trims Trim[]

  @@unique([brandId, slug])
  @@index([bodyType, active])
  @@map("models")
}

/// Version comercial concreta. Es la unidad de homologacion ante MinTransporte
/// (por eso homologationCostCop se amortiza entre las unidades del mismo Trim).
model Trim {
  id                 String   @id @default(cuid())
  modelId            String
  slug               String
  name               String // "GT-Line AWD 77.4 kWh"
  modelYear          Int
  marketCode         String? // mercado de destino de fabrica: US, EU, CN, GCC
  hsCodeId           String? // subpartida sugerida por defecto
  factoryCountryCode String?  @db.Char(2) // pais de FABRICACION = origen aduanero real
  msrpUsd            Decimal? @db.Decimal(14, 2)
  active             Boolean  @default(true)

  // Homologacion: se paga una vez por version y se prorratea entre unidades
  homologated                Boolean   @default(false)
  homologationRef            String?
  homologationAt             DateTime?
  homologationCostCop        Decimal?  @db.Decimal(18, 2)
  homologationUnitsAmortized Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model       Model        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  hsCode      HsCode?      @relation(fields: [hsCodeId], references: [code])
  spec        VehicleSpec?
  vehicles    Vehicle[]
  rawListings RawListing[]

  @@unique([modelId, slug, modelYear])
  @@index([hsCodeId])
  @@index([active, modelYear])
  @@map("trims")
}

/// LAS 21 DIMENSIONES FILTRABLES DE LA VITRINA.
/// Relacion 1:1 con Trim. Todos los campos son nullable porque una fuente
/// scrapeada rara vez trae los 21; completitud se mide con specCompleteness.
model VehicleSpec {
  id     String @id @default(cuid())
  trimId String @unique

  // (1) carroceria  (2) motorizacion  (3) transmision  (4) traccion
  bodyType     BodyType
  powertrain   Powertrain
  transmission Transmission?
  driveType    DriveType?

  // (5) cilindrada  (6) potencia  (7) torque
  engineDisplacementCc Int?
  horsepowerHp         Int?
  torqueNm             Int?

  // (8) bateria  (9) autonomia  (10) estandar de autonomia
  batteryKwh    Decimal?       @db.Decimal(6, 2)
  rangeKm       Int?
  rangeStandard RangeStandard?

  // (11) carga AC  (12) carga DC  (13) consumo
  chargeAcKw        Decimal? @db.Decimal(5, 2)
  chargeDcKw        Decimal? @db.Decimal(6, 2)
  consumptionKwh100 Decimal? @db.Decimal(5, 2)
  fuelEconomyKmGal  Decimal? @db.Decimal(5, 2)

  // (14) 0-100  (15) velocidad maxima
  zeroToHundredS Decimal? @db.Decimal(4, 2)
  topSpeedKph    Int?

  // (16) plazas  (17) puertas  (18) baul
  seats       Int?
  doors       Int?
  cargoLiters Int?

  // (19) peso  (20) despeje  (21) norma de emisiones
  curbWeightKg      Int?
  groundClearanceMm Int?
  emissionStandard  EmissionStandard?

  // Extras no filtrables pero necesarios para la ficha y el flete
  lengthMm             Int?
  widthMm              Int?
  heightMm             Int?
  wheelbaseMm          Int?
  cbm                  Decimal? @db.Decimal(7, 3) // volumen para prorrateo por CBM
  towingKg             Int?
  ncapStars            Int?
  airbags              Int?
  warrantyYears        Int?
  batteryWarrantyYears Int?
  features             Json? // ADAS, infoentretenimiento, etc. (no filtrable, solo ficha)

  specCompleteness Int      @default(0) // 0-100, cuantas de las 21 estan llenas
  sourceNote       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trim Trim @relation(fields: [trimId], references: [id], onDelete: Cascade)

  // Indices que soportan los filtros combinados de la vitrina
  @@index([powertrain, bodyType])
  @@index([batteryKwh, rangeKm])
  @@index([horsepowerHp])
  @@index([seats, doors])
  @@map("vehicle_specs")
}

/// Unidad fisica concreta (VIN o lote de subasta).
/// Los campos denormalizados (brandId..powertrain) existen para que la vitrina
/// filtre y ordene sin joins; se sincronizan en el service layer al guardar.
model Vehicle {
  id     String @id @default(cuid())
  trimId String
  slug   String @unique

  vin       String? @unique @db.VarChar(17)
  lotNumber String? // numero de lote en subasta
  stockCode String? @unique // codigo interno TG-2026-0001

  condition         VehicleCondition  @default(NEW)
  titleStatus       TitleStatus       @default(MSO)
  importRegime      ImportRegime      @default(ORDINARY_IMPORT)
  eligibilityStatus EligibilityStatus @default(NEEDS_REVIEW)
  eligibilityNote   String?           @db.Text // por que quedo BLOCKED / NEEDS_REVIEW

  modelYear     Int
  mileageKm     Int     @default(0)
  exteriorColor String?
  interiorColor String?
  plateOrigin   String?

  status      VehicleStatus @default(DRAFT)
  isPublished Boolean       @default(false)
  publishedAt DateTime?
  featured    Boolean       @default(false)

  // Origen aduanero y logistico
  originCountryCode   String  @db.Char(2) // pais de FABRICACION (define el TLC aplicable)
  shipFromCountryCode String? @db.Char(2) // pais desde el que embarca (puede diferir)
  originPortId        String?
  hsCodeId            String?

  // Costos de origen (moneda de compra + USD normalizado)
  purchaseCurrency Currency @default(USD)
  purchasePrice    Decimal? @db.Decimal(14, 2)
  fobUsd           Decimal? @db.Decimal(14, 2) // base del umbral FOB del impoconsumo
  auctionFeeUsd    Decimal? @db.Decimal(14, 2)
  listPriceUsd     Decimal? @db.Decimal(14, 2) // precio de vitrina en origen

  // Cache del landed cost para ordenar/filtrar la vitrina por precio final.
  // NO es vinculante: la cifra vinculante vive en Quote.calcSnapshot.
  estLandedCop        Decimal?  @db.Decimal(18, 2)
  estLandedAt         DateTime?
  estLandedParamSetId String?

  cbm      Decimal? @db.Decimal(7, 3)
  weightKg Int?

  // Denormalizado para la vitrina de 21 filtros
  brandId    String
  modelId    String
  powertrain Powertrain
  bodyType   BodyType

  sourceId      String?
  rawListingId  String?   @unique
  externalUrl   String?
  auctionEndsAt DateTime?

  seoTitle       String?
  seoDescription String? @db.Text
  descriptionMd  String? @db.Text
  damageNotes    String? @db.Text

  ownerUserId String? // se llena cuando se entrega al cliente final
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  trim          Trim        @relation(fields: [trimId], references: [id])
  hsCode        HsCode?     @relation(fields: [hsCodeId], references: [code])
  originCountry Country     @relation("VehicleOriginCountry", fields: [originCountryCode], references: [code])
  originPort    Port?       @relation("VehicleOriginPort", fields: [originPortId], references: [id])
  source        Source?     @relation(fields: [sourceId], references: [id])
  rawListing    RawListing? @relation(fields: [rawListingId], references: [id])

  images          VehicleImage[]
  quoteVehicles   QuoteVehicle[]
  consolidations  ConsolidationItem[]
  orderItems      OrderItem[]
  documentUploads DocumentUpload[]
  gpsPings        GpsPing[]
  channelListings ChannelListing[]
  leads           Lead[]
  socialCards     SocialAsset[]
  milestones      TrackingMilestone[]

  @@index([isPublished, status, featured])
  @@index([brandId, modelId, modelYear])
  @@index([powertrain, bodyType, isPublished])
  @@index([originCountryCode, status])
  @@index([estLandedCop])
  @@index([eligibilityStatus])
  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  thumbUrl  String?
  alt       String?
  width     Int?
  height    Int?
  blurhash  String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  sourceUrl String? // url original si vino de scraping
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, sortOrder])
  @@map("vehicle_images")
}

// =====================================================================
// 4. SOURCING: fuentes, jobs de scraping y staging
//    Regla de oro: NADA scrapeado toca el catalogo publico directamente.
//    Source -> ScrapeJob -> ScrapeRun -> RawListing -> (revision) -> Vehicle
// =====================================================================

model Source {
  id          String         @id @default(cuid())
  code        String         @unique // MANHEIM_US, COPART, ALIBABA, DEALER_DXB_01
  name        String
  type        SourceType
  countryCode String?        @db.Char(2)
  baseUrl     String?
  strategy    IngestStrategy @default(MANUAL_UPLOAD)

  // Cumplimiento: no scrapear a ciegas. Manheim/Copart exigen contrato.
  termsReviewed Boolean @default(false)
  termsUrl      String?
  robotsAllowed Boolean @default(false)
  contractRef   String?
  legalRiskNote String? @db.Text

  authRef         String? // nombre de la variable de entorno con las credenciales
  rateLimitRpm    Int      @default(20)
  defaultCurrency Currency @default(USD)
  trustScore      Int      @default(50) // 0-100, prioriza en el matching de duplicados
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jobs        ScrapeJob[]
  rawListings RawListing[]
  vehicles    Vehicle[]

  @@index([type, active])
  @@map("sources")
}

model ScrapeJob {
  id           String    @id @default(cuid())
  sourceId     String
  name         String
  cron         String? // "0 */6 * * *"
  enabled      Boolean   @default(true)
  targetUrl    String?
  searchParams Json? // filtros: marca, ano, precio max
  selectorMap  Json? // mapa campo -> selector CSS / JSONPath
  fieldMapping Json? // mapa campo externo -> campo canonico
  maxPages     Int       @default(5)
  concurrency  Int       @default(1)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  source Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  runs   ScrapeRun[]

  @@index([enabled, nextRunAt])
  @@map("scrape_jobs")
}

model ScrapeRun {
  id           String    @id @default(cuid())
  jobId        String
  status       RunStatus @default(QUEUED)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  pagesFetched Int       @default(0)
  itemsFound   Int       @default(0)
  itemsNew     Int       @default(0)
  itemsUpdated Int       @default(0)
  itemsFailed  Int       @default(0)
  httpErrors   Int       @default(0)
  errorMessage String?   @db.Text
  logUrl       String?
  triggeredBy  ActorType @default(CRON)

  job         ScrapeJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rawListings RawListing[]

  @@index([jobId, startedAt])
  @@index([status, startedAt])
  @@map("scrape_runs")
}

/// Staging inmutable: el payload crudo tal como llego. Nunca se edita;
/// la normalizacion escribe en las columnas normalized* y deja rawPayload intacto.
model RawListing {
  id         String  @id @default(cuid())
  sourceId   String
  runId      String?
  externalId String // id del lote / anuncio en la fuente
  url        String?

  rawPayload  Json
  payloadHash String @db.Char(64) // sha256 para deduplicar y detectar cambios

  // Campos normalizados por el parser
  normalizedBrand     String?
  normalizedModel     String?
  normalizedTrim      String?
  normalizedYear      Int?
  normalizedVin       String?
  normalizedMileageKm Int?
  normalizedPrice     Decimal?          @db.Decimal(14, 2)
  normalizedCurrency  Currency?
  normalizedCondition VehicleCondition?
  normalizedCountry   String?           @db.Char(2)
  imageUrls           String[]

  matchedTrimId   String?
  matchConfidence Decimal?         @db.Decimal(5, 4) // 0.0000 - 1.0000
  status          RawListingStatus @default(NEW)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  firstSeenAt     DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  expiresAt       DateTime?

  source      Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  run         ScrapeRun? @relation(fields: [runId], references: [id])
  matchedTrim Trim?      @relation(fields: [matchedTrimId], references: [id])
  vehicle     Vehicle?

  @@unique([sourceId, externalId])
  @@index([status, lastSeenAt])
  @@index([payloadHash])
  @@index([normalizedVin])
  @@map("raw_listings")
}

// =====================================================================
// 5. MOTOR PARAMETRICO — parametros versionados
//    REGLA: ninguna tarifa vive en el codigo. Todo es una fila editable
//    en /admin/parametros, con vigencia y trazabilidad de fuente.
// =====================================================================

/// Confianza del dato, decidida por quien lo carga. Gobierna si el motor puede
/// cotizar en firme con el, o solo con advertencia. Ver docs/SEED-DATA.md §8.
enum DataConfidence {
  VERIFIED // contrastado contra fuente primaria
  ESTIMATED // referencia de mercado o inferencia razonada
  UNVERIFIED // cargado sin respaldo: el motor NO cotiza en firme
}

/// Como se mantiene fresco cada dato. Solo la TRM tiene API oficial gratuita.
enum UpdateMode {
  AUTOMATIC // cron contra fuente oficial
  ASSISTED // el sistema avisa que vencio y pide reconfirmacion
  MANUAL // solo cambia cuando el operador lo cambia
}

/// Resultado de resolver un parametro. El motor NUNCA devuelve un default
/// silencioso: o hay valor, o hay valor con advertencia, o no se cotiza.
enum ResolutionStatus {
  VALOR
  VALOR_CON_ADVERTENCIA
  NO_COTIZABLE
}

model PricingParameterSet {
  id        String             @id @default(cuid())
  version   Int                @unique
  label     String?
  status    ParameterSetStatus @default(DRAFT)
  validFrom DateTime           @db.Date
  validTo   DateTime?          @db.Date
  notes     String?

  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author               User?                 @relation("ParamSetAuthor", fields: [authorId], references: [id])
  tariffRules          TariffRule[]
  freightRates         FreightRate[]
  destinationCostRules DestinationCostRule[]
  addOnProducts        AddOnProduct[]
  margins              MarginRule[]
  quotes               Quote[]

  @@index([status, validFrom])
  @@map("pricing_parameter_sets")
}

/// Historico de tasas de cambio.
/// Dos TRM distintas conviven a proposito (docs/SEED-DATA.md §1.3):
///   TRM_DAILY        -> comercial, para mostrar
///   TRM_CUSTOMS_WEEK -> fiscal, ultimo dia habil de la semana anterior a la
///                       aceptacion de la declaracion (Dto 1165/2019 art. 15)
model FxRate {
  id        String     @id @default(cuid())
  kind      FxRateKind @default(TRM_DAILY)
  base      Currency   @default(USD)
  quote     Currency   @default(COP)
  rate      Decimal    @db.Decimal(14, 6)
  /// Rango de vigencia publicado por la fuente (la TRM del viernes rige hasta el lunes).
  validFrom DateTime   @db.Date
  validTo   DateTime   @db.Date

  source    FxSource @default(DATOS_GOV_CO)
  sourceRef String? // dataset / endpoint / documento
  fetchedAt DateTime @default(now())

  /// Override manual: exige razon, y queda auditado.
  overriddenById String?
  overrideReason String?

  createdAt DateTime @default(now())

  overriddenBy User? @relation("FxOverrideBy", fields: [overriddenById], references: [id])

  @@unique([kind, base, quote, validFrom])
  @@index([kind, validFrom, validTo])
  @@map("fx_rates")
}

/// Regla arancelaria. Se resuelve por (subpartida x pais de ORIGEN x
/// motorizacion x fecha), de lo mas especifico a lo mas general.
///
/// DOS INVARIANTES QUE EL MOTOR NO PUEDE VIOLAR:
///  1. `legalBasis` es OBLIGATORIO. Una tarifa sin norma que la sustente no se
///     siembra: el PDF tiene que poder citar de donde sale cada cifra.
///  2. `originCountryCode` es el pais de ORIGEN (regla de origen + expedicion
///     directa), NUNCA el pais de compra. Un carro comprado en EE.UU. pero
///     fabricado en Corea no accede a la preferencia del TLC con EE.UU.
model TariffRule {
  id             String @id @default(cuid())
  parameterSetId String

  /// Subpartida a 10 digitos exactos, sin puntos. Nunca resolver por "8703".
  hsCodeValue       String      @db.VarChar(10)
  originCountryCode String?     @db.Char(2) // null = comodin (NMF / erga omnes)
  powertrain        Powertrain? // null = aplica a cualquier motorizacion
  agreementId       String?

  /// Tarifas como fracciones: 0.400000 = 40%
  dutyRate   Decimal @db.Decimal(9, 6)
  vatRate    Decimal @db.Decimal(9, 6)
  exciseRate Decimal @db.Decimal(9, 6)

  /// Composicion de cada base. Por defecto la correcta segun ET art. 459 y 512-3.
  dutyBase   TaxBaseKind @default(CIF)
  vatBase    TaxBaseKind @default(CIF_PLUS_ARANCEL)
  exciseBase TaxBaseKind @default(TOTAL_VALUE_EXCL_IVA)

  /// Umbral del impoconsumo, en USD FOB. Nominal, NO indexado a UVT.
  exciseThresholdFobUsd    Decimal? @db.Decimal(14, 2)
  exciseRateAboveThreshold Decimal? @db.Decimal(9, 6)

  /// El impoconsumo solo se causa en la importacion cuando el importador ES el
  /// consumidor final (ET art. 512-1 num. 2). Si no, se causa en la venta.
  exciseAppliesOnImport Boolean @default(true)

  requiresOriginCertificate Boolean @default(false)

  /// OBLIGATORIO. Sin norma, no hay regla.
  legalBasis String
  legalUrl   String?

  confidence     DataConfidence @default(UNVERIFIED)
  updateMode     UpdateMode     @default(MANUAL)
  verifiedAt     DateTime?
  verifiedBy     String?
  /// El motor advierte cuando la verificacion supera este umbral.
  staleAfterDays Int            @default(90)

  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parameterSet  PricingParameterSet @relation(fields: [parameterSetId], references: [id], onDelete: Cascade)
  hsCode        HsCode              @relation(fields: [hsCodeValue], references: [code])
  originCountry Country?            @relation(fields: [originCountryCode], references: [code])
  agreement     TradeAgreement?     @relation(fields: [agreementId], references: [id])

  @@unique([parameterSetId, hsCodeValue, originCountryCode, powertrain, validFrom])
  @@index([hsCodeValue, originCountryCode, validFrom, validTo])
  @@index([parameterSetId, confidence])
  @@map("tariff_rules")
}

model FreightRate {
  id             String @id @default(cuid())
  parameterSetId String

  originPortId      String
  destinationPortId String
  mode              FreightMode
  basis             FreightBasis @default(PER_CONTAINER)

  amountUsd  Decimal @db.Decimal(14, 2)
  surcharges Decimal @default(0) @db.Decimal(14, 2) // BAF, CAF, THC, ISPS, BL

  transitDaysMin Int
  transitDaysMax Int

  /// Capacidad por defecto del equipo, para el prorrateo.
  vehiclesPerUnit Int?     @default(1)
  maxPayloadKg    Decimal? @db.Decimal(10, 2)

  confidence     DataConfidence @default(ESTIMATED)
  updateMode     UpdateMode     @default(ASSISTED)
  /// El flete es el dato mas volatil del motor: Asia-WCSA se multiplico por 2,5
  /// en cinco meses de 2026. Vence rapido a proposito.
  staleAfterDays Int            @default(21)
  verifiedAt     DateTime?
  sourceRef      String?

  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parameterSet    PricingParameterSet @relation(fields: [parameterSetId], references: [id], onDelete: Cascade)
  originPort      Port                @relation("FreightOrigin", fields: [originPortId], references: [id])
  destinationPort Port                @relation("FreightDestination", fields: [destinationPortId], references: [id])

  @@unique([parameterSetId, originPortId, destinationPortId, mode, validFrom])
  @@index([originPortId, destinationPortId, validFrom])
  @@map("freight_rates")
}

model DestinationCostRule {
  id             String @id @default(cuid())
  parameterSetId String

  code     String // PORT_UIP, STORAGE_DAY, BROKERAGE, VUCE, ANLA_CEPD, PLATES...
  category CostCategory
  labelEs  String
  labelEn  String

  method   CalcMethod
  currency Currency   @default(COP)
  amount   Decimal    @default(0) @db.Decimal(18, 2)
  /// Para metodos porcentuales: 0.008000 = 0,8%
  rate     Decimal?   @db.Decimal(9, 6)
  minimum  Decimal?   @db.Decimal(18, 2)
  maximum  Decimal?   @db.Decimal(18, 2)
  formula  String?

  /// Alcance opcional: puerto, regimen, motorizacion.
  portId       String?
  importRegime ImportRegime?
  powertrain   Powertrain?

  taxable      Boolean @default(false) // lleva IVA en la factura de servicio
  /// Si entra en la base gravable del impoconsumo. El perimetro exacto esta en
  /// consulta con la SIA (SEED-DATA §9 Q4), asi que es un parametro, no un supuesto.
  inExciseBase Boolean @default(false)

  confidence     DataConfidence @default(ESTIMATED)
  updateMode     UpdateMode     @default(ASSISTED)
  staleAfterDays Int            @default(180)
  verifiedAt     DateTime?
  legalBasis     String?
  sourceRef      String?

  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  sortOrder Int       @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parameterSet PricingParameterSet @relation(fields: [parameterSetId], references: [id], onDelete: Cascade)

  @@unique([parameterSetId, code, portId, validFrom])
  @@index([parameterSetId, category])
  @@map("destination_cost_rules")
}

model MarginRule {
  id             String @id @default(cuid())
  parameterSetId String

  code     String
  labelEs  String
  labelEn  String
  method   CalcMethod @default(PERCENT_OF_LANDED)
  rate     Decimal?   @db.Decimal(9, 6)
  amount   Decimal?   @db.Decimal(18, 2)
  currency Currency   @default(COP)

  /// La comision de pasarela se calcula SOLO sobre el anticipo: ninguna pasarela
  /// colombiana puede cobrar un vehiculo completo (PSE tope ~COP 2,4M).
  appliesToDepositOnly Boolean @default(false)

  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parameterSet PricingParameterSet @relation(fields: [parameterSetId], references: [id], onDelete: Cascade)

  @@unique([parameterSetId, code])
  @@map("margin_rules")
}

model AddOnProduct {
  id             String @id @default(cuid())
  parameterSetId String

  code          String
  labelEs       String
  labelEn       String
  descriptionEs String?
  descriptionEn String?

  stage    String // ORIGIN | DESTINATION
  category String // ACCESSORY | PROTECTION | WARRANTY | LEGAL | MAINTENANCE
  currency Currency @default(COP)
  price    Decimal  @db.Decimal(18, 2)
  taxable  Boolean  @default(true)

  /// Restricciones de compatibilidad, p.ej. wallbox solo para BEV/PHEV.
  requiresPowertrain Powertrain[]
  active             Boolean      @default(true)
  sortOrder          Int          @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parameterSet PricingParameterSet @relation(fields: [parameterSetId], references: [id], onDelete: Cascade)
  quoteLines   QuoteLineItem[]

  @@unique([parameterSetId, code])
  @@map("addon_products")
}

/// Referencias de mercado. NO son tarifas y NUNCA alimentan el motor: disparan
/// una revision cuando se alejan de lo sembrado. Ver docs/SEED-DATA.md §7.
model MarketReference {
  id         String   @id @default(cuid())
  topic      String // FREIGHT_ASIA_WCSA, PANAMA_DRAFT, PORT_STATUS_BUN
  labelEs    String
  value      String
  unit       String?
  observedAt DateTime @db.Date
  sourceRef  String?
  notes      String?
  createdAt  DateTime @default(now())

  @@index([topic, observedAt])
  @@map("market_references")
}

// =====================================================================
// 6. CONSOLIDACION Y COTIZACION
// =====================================================================

model Consolidation {
  id        String      @id @default(cuid())
  reference String      @unique
  mode      FreightMode @default(CONTAINER_40HC)

  originPortId      String
  destinationPortId String

  containerCostUsd Decimal @db.Decimal(14, 2)
  surchargesUsd    Decimal @default(0) @db.Decimal(14, 2)

  /// Dos metodos distintos a proposito: el comercial es libre, el de base
  /// gravable esta restringido por la Res. 1684 de 2014 CAN.
  commercialAllocation  AllocationMethod            @default(BY_CIF_VALUE)
  taxableBaseAllocation TaxableBaseAllocationMethod @default(BY_FOB_VALUE)

  maxVehicles  Int      @default(4)
  maxPayloadKg Decimal? @db.Decimal(10, 2)

  bookingRef   String?
  billOfLading String?
  vesselName   String?
  etd          DateTime? @db.Date
  eta          DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  originPort      Port                @relation("ConsolidationOrigin", fields: [originPortId], references: [id])
  destinationPort Port                @relation("ConsolidationDestination", fields: [destinationPortId], references: [id])
  items           ConsolidationItem[]

  @@index([originPortId, destinationPortId, etd])
  @@map("consolidations")
}

model ConsolidationItem {
  id              String @id @default(cuid())
  consolidationId String
  vehicleId       String

  /// Participacion resultante del metodo elegido (0.333333 = 33,3333%).
  commercialShare       Decimal @db.Decimal(9, 6)
  taxableBaseShare      Decimal @db.Decimal(9, 6)
  /// Flete asignado en USD. La suma de las filas debe ser EXACTA.
  allocatedFreightUsd   Decimal @db.Decimal(14, 2)
  /// Residuo de redondeo absorbido por esta fila. Visible a proposito.
  roundingAdjustmentUsd Decimal @default(0) @db.Decimal(14, 2)

  manualShare Decimal? @db.Decimal(9, 6)
  slot        Int?

  createdAt DateTime @default(now())

  consolidation Consolidation @relation(fields: [consolidationId], references: [id], onDelete: Cascade)
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])

  @@unique([consolidationId, vehicleId])
  @@map("consolidation_items")
}

/// Una cotizacion es un SNAPSHOT INMUTABLE desde que pasa a SENT.
/// Guarda el resultado completo, el set de parametros y las TRM usadas, para que
/// el PDF de hace un mes se reproduzca identico hoy.
model Quote {
  id        String      @id @default(cuid())
  reference String      @unique // COT-2026-0412
  status    QuoteStatus @default(DRAFT)
  locale    String      @default("es") // el PDF se reimprime en el idioma de emision

  /// El consecutivo, como DATOS y no como texto. `reference` se deriva de estos
  /// dos, asi que la unicidad del numero es una restriccion de la base y no una
  /// promesa del codigo. `issueYear` es el ano CIVIL EN BOGOTA en el momento de
  /// emitir: nunca se recalcula desde `createdAt`, que esta en UTC y cambia de
  /// ano cinco horas antes.
  issueYear Int
  sequence  Int

  customerId  String?
  createdById String?
  leadId      String?

  parameterSetId String

  /// TRM comercial (mostrada) y fiscal (liquidacion). Son distintas a proposito.
  trmCommercial Decimal  @db.Decimal(14, 6)
  trmFiscal     Decimal? @db.Decimal(14, 6)
  trmDate       DateTime @db.Date

  fxPolicy       FxPolicy @default(BANDED)
  fxToleranceBps Int?     @default(200) // 2%

  /// Sin @default: una cotizacion a la que le falte una cifra debe fallar al
  /// escribirse, no guardarse en cero. Un cero por defecto en una columna de
  /// dinero es una cotizacion de regalo esperando a que alguien la envie.
  subtotalUsd     Decimal  @db.Decimal(14, 2)
  taxesCop        Decimal  @db.Decimal(18, 2)
  landedCostCop   Decimal  @db.Decimal(18, 2)
  totalCop        Decimal  @db.Decimal(18, 2)
  /// Techo de la banda cuando algun switch determinante quedo sin cerrar.
  totalCopCeiling Decimal? @db.Decimal(18, 2)

  resolutionStatus ResolutionStatus @default(VALOR_CON_ADVERTENCIA)

  /// El calculo completo: lineas, reglas aplicadas, parametros, advertencias.
  /// Nunca se recalcula una cotizacion enviada.
  ///
  /// NOT NULL a proposito. El criterio de aceptacion de M5 es que el PDF se
  /// reproduzca identico una semana despues; una fila sin instantanea reserva
  /// un numero de cotizacion que jamas podra reimprimirse.
  snapshot        Json
  /// Version del formato de la instantanea. Permite anadir campos sin romper la
  /// lectura de cotizaciones ya emitidas, que por definicion no se pueden migrar.
  snapshotVersion Int  @default(1)

  estimatedDays Int?
  validUntil    DateTime?
  sentAt        DateTime?
  viewedAt      DateTime?
  acceptedAt    DateTime?
  pdfUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     User?               @relation("QuoteCustomer", fields: [customerId], references: [id])
  createdBy    User?               @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  lead         Lead?               @relation(fields: [leadId], references: [id])
  parameterSet PricingParameterSet @relation(fields: [parameterSetId], references: [id])
  vehicles     QuoteVehicle[]
  lineItems    QuoteLineItem[]
  readiness    QuoteReadiness[]
  orders       Order[]

  /// La cotizacion que reemplaza a esta. Se llena al versionar una oferta.
  supersededById String? @unique
  supersededBy   Quote?  @relation("QuoteSupersession", fields: [supersededById], references: [id])
  supersedes     Quote?  @relation("QuoteSupersession")

  /// El consecutivo es unico DENTRO del ano. Es la restriccion que hace
  /// imposible que dos guardados simultaneos produzcan el mismo numero.
  @@unique([issueYear, sequence])
  @@index([status, createdAt])
  @@index([customerId, status])
  @@map("quotes")
}

/// Asignador del consecutivo de cotizaciones.
///
/// Existe porque `reference @unique` NO evita la colision, solo la castiga:
/// dos usuarios que guarden en el mismo milisegundo leen ambos el mismo maximo,
/// escriben ambos COT-2026-0412, y el perdedor recibe un 23505 que revienta su
/// transaccion completa. `SELECT max(...) FOR UPDATE` tampoco sirve, porque no
/// hay fila que bloquear para un numero que todavia no existe.
///
/// La solucion es una fila POR ANO que si se puede bloquear:
///   UPDATE quote_counters SET next = next + 1 WHERE issue_year = $1 RETURNING next
/// El bloqueo de fila de Postgres serializa a los escritores, y el segundo
/// espera al primero en vez de chocar con el.
model QuoteCounter {
  issueYear Int      @id
  next      Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("quote_counters")
}

model QuoteVehicle {
  id        String  @id @default(cuid())
  quoteId   String
  vehicleId String?

  /// Denormalizado a proposito: la cotizacion debe seguir legible aunque el
  /// vehiculo se borre o cambie de precio.
  descriptionEs     String
  hsCodeValue       String?     @db.VarChar(10)
  powertrain        Powertrain?
  originCountryCode String?     @db.Char(2)
  modelYear         Int?

  fobUsd        Decimal @db.Decimal(14, 2)
  cifUsd        Decimal @db.Decimal(14, 2)
  landedCostCop Decimal @db.Decimal(18, 2)

  containerShare Int @default(1)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@map("quote_vehicles")
}

model QuoteLineItem {
  id      String @id @default(cuid())
  quoteId String

  /// Codigo estable de la etapa del motor: TAX.ARANCEL, FREIGHT.OCEAN...
  /// Es tambien la clave i18n: messages/<locale>/pricing.json -> stages.TAX.ARANCEL.
  stageCode String
  kind      LineItemKind
  block     String // ORIGIN | FREIGHT | TAX | DESTINATION | ADDON | COMMERCIAL

  labelEs String
  labelEn String
  noteEs  String?
  noteEn  String?

  currency  Currency @default(COP)
  amountUsd Decimal? @db.Decimal(14, 2)
  amountCop Decimal  @db.Decimal(18, 2)

  /// Trazabilidad: que regla produjo esta linea y con que base legal.
  appliedRuleId   String?
  appliedRuleKind String? // TariffRule | FreightRate | DestinationCostRule | MarginRule
  legalBasis      String?
  baseKind        TaxBaseKind?
  baseAmountCop   Decimal?     @db.Decimal(18, 2)
  rateApplied     Decimal?     @db.Decimal(9, 6)

  resolutionStatus ResolutionStatus @default(VALOR)
  warning          String?

  addOnProductId String?
  sortOrder      Int     @default(100)

  quote        Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  addOnProduct AddOnProduct? @relation(fields: [addOnProductId], references: [id])

  @@index([quoteId, sortOrder])
  @@map("quote_line_items")
}

/// Gate de completitud. Una Quote no puede pasar a SENT mientras cualquiera de
/// los switches determinantes siga sin decision humana explicita.
/// Los seis switches tienen un lado barato que es tambien el default descuidado;
/// este modelo obliga a elegir a conciencia. Ver docs/SEED-DATA.md §8.
model QuoteReadiness {
  id      String @id @default(cuid())
  quoteId String

  switchCode       String // ORIGIN_CERTIFICATE, HS_CLASSIFICATION, IMPORTER_IS_END_CONSUMER,
  // EXCISE_COST_PERIMETER, PORT_DAYS, FREIGHT_FRESHNESS
  chosenValue      String
  isExplicitChoice Boolean   @default(false)
  evidence         String?
  decidedById      String?
  decidedAt        DateTime?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, switchCode])
  @@map("quote_readiness")
}

// =====================================================================
// 7. PEDIDOS, SEGUIMIENTO Y DOCUMENTOS
// =====================================================================

model Order {
  id        String      @id @default(cuid())
  reference String      @unique // PED-2026-0118
  status    OrderStatus @default(DRAFT)
  locale    String      @default("es")

  customerId       String
  accountManagerId String?
  quoteId          String?

  /// Decide si el impoconsumo se causa en la nacionalizacion o en la venta,
  /// y mueve la base gravable 8-16 puntos. Ver docs/SEED-DATA.md §1.2.
  importerIsEndConsumer Boolean      @default(true)
  importRegime          ImportRegime @default(ORDINARY_IMPORT)

  totalCop   Decimal @db.Decimal(18, 2)
  depositCop Decimal @default(0) @db.Decimal(18, 2)
  paidCop    Decimal @default(0) @db.Decimal(18, 2)

  /// Semaforo doble que ve el cliente en el portal.
  documentaryLight TrafficLight @default(GREY)
  physicalLight    TrafficLight @default(GREY)

  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer       User                @relation("OrderCustomer", fields: [customerId], references: [id])
  accountManager User?               @relation("OrderAccountManager", fields: [accountManagerId], references: [id])
  quote          Quote?              @relation(fields: [quoteId], references: [id])
  items          OrderItem[]
  events         OrderStatusEvent[]
  milestones     TrackingMilestone[]
  documents      DocumentUpload[]
  gpsPings       GpsPing[]
  payments       Payment[]

  @@index([status, createdAt])
  @@index([customerId, status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  vehicleId String?

  descriptionEs String
  unitPriceCop  Decimal @db.Decimal(18, 2)
  quantity      Int     @default(1)
  isAddOn       Boolean @default(false)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@map("order_items")
}

model OrderStatusEvent {
  id      String @id @default(cuid())
  orderId String

  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  isInternal Boolean      @default(false)

  actorType ActorType @default(USER)
  actorId   String?
  createdAt DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model TrackingMilestone {
  id        String  @id @default(cuid())
  orderId   String
  vehicleId String?

  code      String // PURCHASE, ORIGIN_PICKUP, LOADED, SAILED, ARRIVED, ...
  labelEs   String
  labelEn   String
  dimension MilestoneDimension @default(PHYSICAL)
  status    MilestoneStatus    @default(PENDING)

  plannedAt         DateTime?
  actualAt          DateTime?
  responsible       String? // NOSOTROS | CLIENTE | SIA | NAVIERA
  isCustomerVisible Boolean   @default(true)
  sortOrder         Int       @default(100)
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@unique([orderId, code])
  @@index([orderId, sortOrder])
  @@map("tracking_milestones")
}

model DocumentRequirement {
  id            String  @id @default(cuid())
  code          String  @unique // BL, FACTURA_COMERCIAL, CERT_ORIGEN, CEPD, FICHA_HOMOLOGACION
  labelEs       String
  labelEn       String
  descriptionEs String?
  descriptionEn String?

  scope        DocumentScope @default(ORDER)
  responsible  String        @default("CLIENTE")
  importRegime ImportRegime?
  mandatory    Boolean       @default(true)
  sortOrder    Int           @default(100)
  active       Boolean       @default(true)

  uploads DocumentUpload[]

  @@map("document_requirements")
}

model DocumentUpload {
  id            String  @id @default(cuid())
  orderId       String?
  vehicleId     String?
  requirementId String?

  fileName  String
  fileUrl   String
  mimeType  String?
  sizeBytes Int?

  status          DocumentStatus @default(UPLOADED)
  rejectionReason String?
  expiresAt       DateTime?

  uploadedById String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order       Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?             @relation(fields: [vehicleId], references: [id])
  requirement DocumentRequirement? @relation(fields: [requirementId], references: [id])
  uploadedBy  User?                @relation("DocUploader", fields: [uploadedById], references: [id])
  reviewedBy  User?                @relation("DocReviewer", fields: [reviewedById], references: [id])

  @@index([orderId, status])
  @@map("document_uploads")
}

model GpsPing {
  id        String  @id @default(cuid())
  orderId   String
  vehicleId String?

  source     GpsSource @default(MANUAL)
  lat        Decimal   @db.Decimal(9, 6)
  lng        Decimal   @db.Decimal(9, 6)
  label      String?
  recordedAt DateTime
  createdAt  DateTime  @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([orderId, recordedAt])
  @@map("gps_pings")
}

model Payment {
  id      String @id @default(cuid())
  orderId String

  kind     PaymentKind     @default(DEPOSIT)
  status   PaymentStatus   @default(PENDING)
  provider PaymentProvider @default(WOMPI)

  currency  Currency @default(COP)
  amount    Decimal  @db.Decimal(18, 2)
  feeAmount Decimal  @default(0) @db.Decimal(18, 2)

  externalRef  String?
  paidAt       DateTime?
  recordedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([orderId, status])
  @@map("payments")
}

// =====================================================================
// 8. CRM Y CHAT
// =====================================================================

model Lead {
  id     String     @id @default(cuid())
  status LeadStatus @default(NEW)
  source LeadSource @default(WEB_FORM)

  name    String?
  email   String?
  phone   String?
  city    String?
  message String?
  locale  String  @default("es")

  // La cedula se pide pronto porque sin ella no hay nacionalizacion posible:
  // es un dato del negocio, no del perfil, y el prospecto que aun no tiene
  // cuenta tambien lo trae.
  documentType String? // CC, CE, NIT, PAS
  documentId   String?

  interestVehicleId String?
  ownerId           String?
  userId            String? @unique

  dataConsentAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner           User?              @relation("LeadOwner", fields: [ownerId], references: [id])
  user            User?              @relation("LeadUser", fields: [userId], references: [id])
  interestVehicle Vehicle?           @relation(fields: [interestVehicleId], references: [id])
  quotes          Quote[]
  conversations   ChatConversation[]

  @@index([status, createdAt])
  @@map("leads")
}

model ChatConversation {
  id      String      @id @default(cuid())
  channel ChatChannel @default(WEB_WIDGET)
  status  ChatStatus  @default(BOT_HANDLING)
  locale  String      @default("es")

  userId    String?
  agentId   String?
  leadId    String?
  visitorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?         @relation("ChatUser", fields: [userId], references: [id])
  agent    User?         @relation("ChatAgent", fields: [agentId], references: [id])
  lead     Lead?         @relation(fields: [leadId], references: [id])
  messages ChatMessage[]

  @@index([status, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String @id @default(cuid())
  conversationId String

  role        ChatRole
  content     String
  toolName    String?
  toolPayload Json?
  createdAt   DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// =====================================================================
// 9. CMS BILINGUE
//    Patron A: tabla de traduccion para contenido con slug y SEO propios.
//    Ver docs/I18N.md §7.
// =====================================================================

model Category {
  id        String   @id @default(cuid())
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())

  translations CategoryTranslation[]
  posts        Post[]

  @@map("categories")
}

model CategoryTranslation {
  id         String @id @default(cuid())
  categoryId String
  locale     String @db.VarChar(5)
  slug       String
  name       String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

model Tag {
  id     String @id @default(cuid())
  slug   String @unique
  nameEs String
  nameEn String

  posts Post[]

  @@map("tags")
}

model Post {
  id            String     @id @default(cuid())
  status        PostStatus @default(DRAFT)
  categoryId    String?
  authorId      String?
  coverImageUrl String?
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     Category?         @relation(fields: [categoryId], references: [id])
  author       User?             @relation(fields: [authorId], references: [id])
  tags         Tag[]
  translations PostTranslation[]

  @@index([status, publishedAt])
  @@map("posts")
}

model PostTranslation {
  id     String @id @default(cuid())
  postId String
  locale String @db.VarChar(5)

  slug           String
  title          String
  excerpt        String?
  body           Json
  seoTitle       String?
  seoDescription String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@unique([locale, slug])
  @@index([locale, slug])
  @@map("post_translations")
}

model Page {
  id        String     @id @default(cuid())
  key       String     @unique // terminos, privacidad, habeas-data, cookies
  status    PostStatus @default(DRAFT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  translations PageTranslation[]

  @@map("pages")
}

model PageTranslation {
  id     String @id @default(cuid())
  pageId String
  locale String @db.VarChar(5)

  slug           String
  title          String
  body           Json
  seoTitle       String?
  seoDescription String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@unique([locale, slug])
  @@map("page_translations")
}

// =====================================================================
// 10. OMNICANALIDAD Y AUDITORIA
// =====================================================================

model ChannelListing {
  id        String               @id @default(cuid())
  channel   ChannelKind
  vehicleId String
  status    ChannelListingStatus @default(DRAFT)

  externalId  String?
  externalUrl String?
  /// Los clasificados colombianos son en espanol. Fijo a proposito (I18N §9).
  locale      String   @default("es")
  priceCop    Decimal? @db.Decimal(18, 2)

  lastSyncedAt DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle  Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  syncLogs ChannelSyncLog[]

  @@unique([channel, vehicleId])
  @@index([channel, status])
  @@map("channel_listings")
}

model ChannelSyncLog {
  id        String @id @default(cuid())
  listingId String

  operation SyncOperation
  success   Boolean       @default(false)
  message   String?
  payload   Json?
  createdAt DateTime      @default(now())

  listing ChannelListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@map("channel_sync_logs")
}

model SocialAsset {
  id        String            @id @default(cuid())
  vehicleId String
  template  SocialTemplate
  locale    String            @default("es")
  imageUrl  String
  width     Int
  height    Int
  // Una pieza generada todavía no es una pieza publicada. Sin esta distincion
  // el panel no puede decir cuantas quedan por sacar, que es justamente la
  // cifra que decide el trabajo del dia.
  status      SocialAssetStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime          @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, template])
  @@index([status, createdAt])
  @@map("social_assets")
}

model AuditLog {
  id        String    @id @default(cuid())
  actorType ActorType @default(USER)
  actorId   String?

  entity   String // TariffRule, PricingParameterSet, Quote, Order...
  entityId String
  action   String // CREATE | UPDATE | DELETE | PUBLISH | OVERRIDE
  before   Json?
  after    Json?
  reason   String?
  ip       String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
