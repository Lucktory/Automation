  PORT_DESTINATION // gastos portuarios Buenaventura / Cartagena
  FREE_ZONE // Zona Franca
  CUSTOMS_BROKER // agenciamiento aduanero
  VUCE // registro / licencia de importacion
  ENVIRONMENTAL // ANLA, CEPD, visto bueno Protocolo de Montreal
  HOMOLOGATION // MinTransporte
  INSPECTION
  STORAGE_DEMURRAGE
  INLAND_DESTINATION
  FINANCIAL // GMF 4x1000, costo de giro, carta de credito
  REGISTRATION // matricula, SOAT, placas, RUNT
  WARRANTY_RESERVE
  MARGIN
  DISCOUNT
  ADDON
  OTHER
}

