// =====================================================================
// AUTOMOCION OS / TOP GEAR - Esquema de datos
// Postgres 15+ / Prisma 6
// Convencion: modelos en ingles, terminos legales colombianos en espanol.
// Dinero: SIEMPRE Decimal. NUNCA Float.
//   - COP  -> @db.Decimal(18, 2)
//   - USD  -> @db.Decimal(14, 2)
//   - tasas/porcentajes -> @db.Decimal(9, 6)  (0.350000 = 35%)
//   - TRM  -> @db.Decimal(14, 6)
// =====================================================================

generator client {
  provider = "prisma-client-js"

  // Adaptador de driver en vez del motor nativo de Prisma.
  //
  // El binario nativo (query_engine-windows.dll.node) aborta con
  // STATUS_ILLEGAL_INSTRUCTION en esta máquina, así que el cliente habla con
  // Neon a través de su driver serverless, que es JavaScript puro. Además es la
  // configuración recomendada para Neon en despliegues serverless, donde el
  // motor nativo tampoco es la mejor opción: menos peso y conexiones por HTTP.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

