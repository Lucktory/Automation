/// CORRECCION VERIFICADA (ver docs/SEED-DATA.md §1.1): el IVA y el impoconsumo
/// NO comparten base. Son bases distintas, gobernadas por articulos distintos,
/// y se calculan EN PARALELO. Ningun tributo entra en la base de otro, salvo el
/// arancel, que entra en las dos.
enum TaxBaseKind {
  FOB // umbral del impoconsumo: 8% si FOB < USD 30.000, 16% si >=
  CIF // valor en aduana. Base del ARANCEL. Dto 1165/2019 art. 16
  CIF_PLUS_ARANCEL // base del IVA en importacion, y SOLO del IVA. ET art. 459
  TOTAL_VALUE_EXCL_IVA // base del IMPOCONSUMO. ET art. 512-3 par. 3
  LANDED
  CUSTOM_FORMULA
}

