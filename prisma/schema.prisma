  FORMULA // expresion evaluada en sandbox, ver DestinationCostRule.formula
}

/// Reparto COMERCIAL del costo del contenedor. Libre: es una decision de negocio.
enum AllocationMethod {
  EQUAL_SHARE // partes iguales
  BY_FOB_VALUE
  BY_CIF_VALUE
  BY_CBM // por volumen ocupado
  BY_WEIGHT
  BY_SLOTS // por cupos del contenedor
  MANUAL
}

/// Prorrateo de la BASE GRAVABLE. Deliberadamente mas estrecho que el comercial.
/// La Res. 1684 de 2014 CAN (arts. 20 y 31 num. 4) exige datos objetivos y
/// cuantificables con documento soporte; el volumen ocupado no consta ni en el
/// B/L ni en la factura, asi que BY_CBM NO puede usarse aqui. Ver SEED-DATA §1.4.
enum TaxableBaseAllocationMethod {
  BY_FOB_VALUE
  BY_WEIGHT
}

